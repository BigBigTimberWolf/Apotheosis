/* ==========================================================================
   Apotheosis — Black & Gold
   accent #D5B56B · text #F0EDE6 · page #101012 · card #19191C
   ========================================================================== */

QMainWindow,
QWidget#centralWidget {
    background-color: #101012;
}

/* 嵌套参数栈保持透明，延续卡片本身的背景。 */
QStackedWidget {
    background: transparent;
    border: none;
}

QDialog {
    background-color: #19191C;
}

QWidget {
    color: #F0EDE6;
    font-size: 13px;
}

/* ── Labels ────────────────────────────────────────────────────────────── */

QLabel {
    background: transparent;
    color: #F0EDE6;
}

QLabel[class="secondary"] {
    color: #ABA697;
    font-size: 12px;
}

QLabel[class="hint"] {
    color: #8E887A;
    font-size: 12px;
}

QLabel[class="heading"] {
    font-size: 15px;
    font-weight: 500;
}

QLabel#cardTitle {
    font-size: 13px;
    color: #F0EDE6;
}

QLabel#cardChevron {
    color: #8E887A;
    font-size: 12px;
}

QLabel#metricValue {
    font-size: 24px;
    font-weight: 500;
    color: #F0EDE6;
}

/* ── Primary tabs ──────────────────────────────────────────────────────── */

QTabBar#primaryTabs {
    background: #19191C;
    border: none;
    border-bottom: 1px solid rgba(213,181,107,0.07);
    qproperty-drawBase: 0;
}

QTabBar#primaryTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 18px;
    margin: 0;
    font-size: 14px;
    color: #A49E90;
}

QTabBar#primaryTabs::tab:first {
    margin-left: 8px;
}

QTabBar#primaryTabs::tab:selected {
    color: #F0EDE6;
    font-weight: 500;
    border-bottom: 2px solid #D5B56B;
}

QTabBar#primaryTabs::tab:hover {
    color: #DCD7CA;
}

/* ── Secondary tabs ────────────────────────────────────────────────────── */

QTabBar#secondaryTabs {
    background: #222226;
    border: none;
    border-bottom: 1px solid rgba(213,181,107,0.07);
    qproperty-drawBase: 0;
}

QTabBar#secondaryTabs::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 16px;
    margin: 0;
    font-size: 13px;
    color: #A49E90;
}

QTabBar#secondaryTabs::tab:first {
    margin-left: 12px;
}

QTabBar#secondaryTabs::tab:selected {
    color: #D5B56B;
    font-weight: 500;
    border-bottom: 2px solid #D5B56B;
}

QTabBar#secondaryTabs::tab:hover {
    color: #DCD7CA;
}

/* ── Card ──────────────────────────────────────────────────────────────── */

QWidget#card {
    background-color: #19191C;
    border: 1px solid #35332D;
    border-radius: 12px;
}

QWidget#cardHeader {
    background: transparent;
    border: none;
}

QFrame#card[role="hero"] {
    background-color: #1E1C17;
    border: 1px solid #4B4028;
}

/* ── Buttons ───────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #222226;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 8px;
    padding: 8px 16px;
    color: #DCD7CA;
    font-size: 13px;
    font-weight: 500;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #2B2923;
    border-color: rgba(213,181,107,0.14);
}

QPushButton:pressed {
    background-color: #353025;
}

QPushButton:disabled {
    background-color: #1C1C1F;
    color: #6D685F;
    border-color: rgba(213,181,107,0.06);
}

QPushButton[class="primary"] {
    background-color: #D5B56B;
    border: none;
    color: #19191C;
    font-weight: 500;
    padding: 9px 18px;
}

QPushButton[class="primary"]:hover {
    background-color: #E9CD8A;
}

QPushButton[class="primary"]:pressed {
    background-color: #B9954C;
}

QPushButton[class="primary"]:disabled {
    background-color: #51462D;
    color: #A49E90;
}

QPushButton[class="danger"] {
    background-color: #E5484D;
    border: none;
    color: #FFFFFF;
    font-weight: 500;
    padding: 9px 18px;
}

QPushButton[class="danger"]:hover {
    background-color: #D63A40;
}

QPushButton[class="danger"]:pressed {
    background-color: #C2363B;
}

/* ── Text inputs ───────────────────────────────────────────────────────── */

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #222226;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 8px;
    padding: 6px 10px;
    color: #F0EDE6;
    font-size: 13px;
    selection-background-color: #59482B;
    selection-color: #F0EDE6;
}

/* plain right-aligned value readout (slider rows) — no box */
QSpinBox#valueSpin,
QDoubleSpinBox#valueSpin {
    background: transparent;
    border: none;
    padding: 0;
    color: #F0EDE6;
    font-size: 13px;
}

QSpinBox#valueSpin:focus,
QDoubleSpinBox#valueSpin:focus {
    background: transparent;
    border: none;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #D5B56B;
    background-color: #19191C;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #1C1C1F;
    color: #6D685F;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
    subcontrol-origin: border;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* ── Combo box ─────────────────────────────────────────────────────────── */

QComboBox {
    background-color: #222226;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 8px;
    padding: 6px 10px;
    color: #DCD7CA;
    font-size: 13px;
    min-height: 16px;
}

QComboBox:hover {
    border-color: rgba(213,181,107,0.16);
}

QComboBox:focus,
QComboBox:on {
    border: 1px solid #D5B56B;
}

QComboBox:disabled {
    background-color: #1C1C1F;
    color: #6D685F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #19191C;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 10px;
    padding: 5px;
    outline: none;
    selection-background-color: #D5B56B;
    selection-color: #19191C;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 10px;
    border-radius: 6px;
    color: #DCD7CA;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #D5B56B;
    color: #101012;
}

/* ── Slider ────────────────────────────────────────────────────────────── */

QSlider {
    min-height: 20px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #35332D;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #D5B56B;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #35332D;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    background: #E9CD8A;
    border: 1px solid rgba(213,181,107,0.14);
}

QSlider::handle:horizontal:hover {
    border-color: #D5B56B;
}

/* ── Check box ─────────────────────────────────────────────────────────── */

QCheckBox {
    spacing: 9px;
    color: #DCD7CA;
    font-size: 13px;
    background: transparent;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid rgba(213,181,107,0.18);
    background-color: #19191C;
}

QCheckBox::indicator:hover {
    border-color: #D5B56B;
}

QCheckBox::indicator:checked {
    background-color: #D5B56B;
    border-color: #D5B56B;
}

/* ── List ──────────────────────────────────────────────────────────────── */

QListWidget {
    background-color: #1D1D20;
    border: 1px solid rgba(213,181,107,0.06);
    border-radius: 12px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    padding: 9px 11px;
    border-radius: 8px;
    margin: 1px 0;
    color: #DCD7CA;
}

QListWidget::item:selected {
    background-color: #302A1E;
    color: #E9CD8A;
}

QListWidget::item:hover:!selected {
    background-color: #26262A;
}

/* ── Scroll bars ───────────────────────────────────────────────────────── */

QScrollArea {
    background: transparent;
    border: none;
}

QAbstractScrollArea {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: rgba(213,181,107,0.16);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(213,181,107,0.28);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(213,181,107,0.16);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(213,181,107,0.28);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0;
    background: transparent;
}

/* ── Status bar ────────────────────────────────────────────────────────── */

QWidget#statusBar {
    background-color: #19191C;
    border-top: 1px solid rgba(213,181,107,0.07);
    min-height: 36px;
}

QWidget#statusBar QLabel {
    color: #ABA697;
    font-size: 12px;
}

/* ── Table ─────────────────────────────────────────────────────────────── */

QTableWidget, QTableView {
    background-color: #19191C;
    alternate-background-color: #1D1D20;
    gridline-color: transparent;
    border: 1px solid rgba(213,181,107,0.07);
    border-radius: 10px;
    selection-background-color: #302A1E;
    selection-color: #F0EDE6;
    font-size: 13px;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid rgba(213,181,107,0.05);
}

QHeaderView::section {
    background-color: #222226;
    border: none;
    border-bottom: 1px solid rgba(213,181,107,0.07);
    color: #A49E90;
    font-size: 12px;
    font-weight: 500;
    padding: 9px 10px;
}

QTableCornerButton::section {
    background-color: #222226;
    border: none;
}

/* ── Log viewer (dark terminal) ────────────────────────────────────────── */

QTextEdit {
    background-color: #111113;
    border: none;
    border-radius: 10px;
    padding: 12px;
    color: #DCD7CA;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #59482B;
}

/* ── Progress bar ──────────────────────────────────────────────────────── */

QProgressBar {
    background-color: #35332D;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #D5B56B;
    border-radius: 4px;
}

/* ── Menu ──────────────────────────────────────────────────────────────── */

QMenu {
    background-color: #19191C;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 6px;
    color: #DCD7CA;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #302A1E;
    color: #E9CD8A;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(213,181,107,0.07);
    margin: 5px 8px;
}

/* ── Tooltip ───────────────────────────────────────────────────────────── */

QToolTip {
    background-color: #222226;
    color: #F0EDE6;
    border: 1px solid #665537;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Splitter ──────────────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: rgba(213,181,107,0.06);
}

QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* ==========================================================================
   Enterprise shell — top nav + secondary sidebar + dashboard
   ========================================================================== */

QLabel[class="tertiary"] { color: #A49E90; font-size: 12px; }
QLabel#heroTitle { font-size: 15px; font-weight: 500; color: #F0EDE6; }

/* ── Top nav ───────────────────────────────────────────────────────────── */

QWidget#topNav {
    background-color: #0C0C0E;
    border-bottom: 1px solid #302E28;
}

QLabel#brandMark {
    background: transparent;
    border: none;
}
QLabel#brandWord { font-size: 14px; font-weight: 600; color: #E9CD8A; }
QFrame#navDivider { background-color: #35332D; border: none; }
QLabel#avatar { background-color: #302A1E; color: #D5B56B; border-radius: 16px; }

QPushButton#primaryNavItem {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 13px;
    color: #ABA697;
    font-size: 14px;
    font-weight: 400;
    min-height: 0;
}
QPushButton#primaryNavItem:hover { background: transparent; color: #F0EDE6; }
QPushButton#primaryNavItem:checked {
    background: transparent;
    color: #E9CD8A;
    font-weight: 500;
    border-bottom: 2px solid #D5B56B;
}

/* ── Secondary sidebar ─────────────────────────────────────────────────── */

QWidget#sideNav {
    background-color: #141416;
    border-right: 1px solid #302E28;
}

QLabel#sideNavTitle {
    color: #8E887A;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 9px;
}

QPushButton#sideNavItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 11px;
    color: #BCB7AA;
    font-size: 13px;
    font-weight: 400;
    text-align: left;
    min-height: 0;
}
QPushButton#sideNavItem:hover { background-color: #1C1C1F; }
QPushButton#sideNavItem:checked {
    background-color: #302A1E;
    color: #E9CD8A;
    font-weight: 500;
}

/* ── Metric card ───────────────────────────────────────────────────────── */

QFrame#metricCard {
    background-color: #19191C;
    border: 1px solid #35332D;
    border-radius: 12px;
}


/* ==========================================================================
   2026 interaction polish ? hierarchy, focus, and restrained state feedback
   ========================================================================== */

QWidget#pageShell {
    background-color: #101012;
}

QWidget#contextHeader {
    background-color: #19191C;
    border-bottom: 1px solid #302E28;
}

QLabel#contextTitle {
    color: #F0EDE6;
    font-size: 18px;
    font-weight: 600;
}

QLabel#contextPath {
    color: #A49E90;
    font-size: 12px;
}

QWidget#card:hover,
QFrame#metricCard:hover {
    border-color: #665537;
}

QPushButton:focus,
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QListWidget:focus,
QTableView:focus,
QTableWidget:focus {
    border-color: #D5B56B;
}

QPushButton#saveBtn {
    min-width: 74px;
}

QPushButton#saveBtn[saved="true"] {
    background-color: #53C583;
    color: #19191C;
}

/* ── 全局配置方案 (顶栏下拉 + ⋯ 菜单) ─────────────────────────────────── */

QLabel#profileIcon {
    color: #A49E90;
}

QComboBox#profileCombo {
    background-color: #222226;
    border: 1px solid rgba(213,181,107,0.08);
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
    color: #DCD7CA;
}

QComboBox#profileCombo:hover {
    border-color: rgba(213,181,107,0.16);
}

QComboBox#profileCombo[feedback="true"] {
    background-color: #1D3026;
    border-color: #53C583;
    color: #7ED7A0;
}

QToolButton#profileMenuBtn {
    min-width: 24px;
    max-width: 24px;
    min-height: 26px;
    max-height: 26px;
    padding: 0;
    color: #A49E90;
}

QToolButton#profileMenuBtn::menu-indicator {
    image: none;
    width: 0;
}

QPushButton#sideNavItem:checked {
    border-left: 3px solid #D5B56B;
    padding-left: 8px;
}

QRadioButton {
    spacing: 8px;
    color: #DCD7CA;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #514C40;
    background-color: #19191C;
}

QRadioButton::indicator:hover {
    border-color: #D5B56B;
}

QRadioButton::indicator:checked {
    border: 5px solid #D5B56B;
    background-color: #19191C;
}

QGroupBox {
    color: #DCD7CA;
    font-weight: 500;
    border: 1px solid #35332D;
    border-radius: 10px;
    margin-top: 10px;
    padding: 14px 12px 10px 12px;
    background-color: #19191C;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #ABA697;
    background-color: #19191C;
}

QPlainTextEdit {
    background-color: #111113;
    border: 1px solid #35332D;
    border-radius: 10px;
    padding: 12px;
    color: #DCD7CA;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #59482B;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 6px;
    color: #ABA697;
}

QToolButton:hover {
    background-color: #26262A;
    color: #DCD7CA;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #3A3020;
    color: #E9CD8A;
}
