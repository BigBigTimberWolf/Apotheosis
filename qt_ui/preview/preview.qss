/* ==========================================================================
   Apotheosis — 黑金预览主题
   accent #D5B56B · text #F0EDE6 · page #101012 · card #19191C
   ========================================================================== */

QMainWindow,
QWidget#centralWidget,
QStackedWidget {
    background-color: #101012;
}

QWidget {
    color: #F0EDE6;
    font-size: 13px;
}

QLabel { background: transparent; color: #F0EDE6; }
QLabel[class="secondary"] { color: #ABA697; font-size: 12px; }
QLabel[class="tertiary"]  { color: #8E887A; font-size: 12px; }
QLabel[class="heading"]   { color: #F0EDE6; font-size: 14px; font-weight: 500; }
QLabel#metricValue { font-size: 24px; font-weight: 500; color: #F0EDE6; }
QLabel#heroTitle   { font-size: 15px; font-weight: 500; color: #F0EDE6; }

/* ── Top nav ─────────────────────────────────────────────────────────── */

QWidget#topNav {
    background-color: #19191C;
    border-bottom: 1px solid #35332D;
}

QLabel#brandMark { background: transparent; border: none; }
QLabel#brandWord { font-size: 14px; font-weight: 600; color: #E9CD8A; }
QFrame#navDivider { background-color: #35332D; border: none; }
QLabel#avatar { background-color: #302A1E; color: #D5B56B; border-radius: 16px; }

QPushButton#primaryNavItem {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 13px;
    color: #ABA697;
    font-size: 14px;
}
QPushButton#primaryNavItem:hover { color: #F0EDE6; }
QPushButton#primaryNavItem:checked {
    color: #F0EDE6;
    font-weight: 500;
    border-bottom: 2px solid #D5B56B;
}

/* ── Secondary sidebar ───────────────────────────────────────────────── */

QWidget#sideNav {
    background-color: #19191C;
    border-right: 1px solid #35332D;
}

QLabel#sideNavTitle {
    color: #8E887A;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 9px;
}

QPushButton#sideNavItem {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px 11px;
    color: #BCB7AA;
    font-size: 13px;
    text-align: left;
}
QPushButton#sideNavItem:hover { background-color: #222226; }
QPushButton#sideNavItem:checked {
    background-color: #302A1E;
    color: #E9CD8A;
    font-weight: 500;
}

/* ── Cards ───────────────────────────────────────────────────────────── */

QFrame#card,
QFrame#metricCard {
    background-color: #19191C;
    border: 1px solid #2B2923;
    border-radius: 12px;
}

/* ── Buttons ─────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #1D1D20;
    border: 1px solid rgba(213,181,107,0.10);
    border-radius: 8px;
    padding: 8px 16px;
    color: #DCD7CA;
    font-size: 13px;
    font-weight: 500;
    min-height: 16px;
}
QPushButton:hover { background-color: #26262A; border-color: rgba(213,181,107,0.14); }
QPushButton:pressed { background-color: #2B2923; }

QPushButton[class="primary"] {
    background-color: #D5B56B;
    border: none;
    color: #19191C;
    font-weight: 500;
    padding: 8px 16px;
}
QPushButton[class="primary"]:hover { background-color: #E9CD8A; }
QPushButton[class="primary"]:pressed { background-color: #E9CD8A; }

QPushButton[class="danger"] {
    background-color: #E5484D;
    border: none;
    color: #19191C;
    font-weight: 500;
    padding: 8px 16px;
}
QPushButton[class="danger"]:hover { background-color: #D63A40; }
QPushButton[class="danger"]:pressed { background-color: #C2363B; }

/* ── Scroll area / bars ──────────────────────────────────────────────── */

QScrollArea { background: transparent; border: none; }
QAbstractScrollArea { background: transparent; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: rgba(213,181,107,0.16); border-radius: 4px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: rgba(213,181,107,0.28); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; background: transparent; }

QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px; }
QScrollBar::handle:horizontal { background: rgba(213,181,107,0.16); border-radius: 4px; min-width: 40px; }
QScrollBar::handle:horizontal:hover { background: rgba(213,181,107,0.28); }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { width: 0; background: transparent; }
